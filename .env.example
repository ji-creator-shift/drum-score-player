# 云同步配置（Supabase）—— 商用模式：登录后才能使用
# 1. 到 https://supabase.com 注册并创建一个项目
# 2. 在项目 Settings -> API 中找到 URL 和 anon public key 填入下面
# 3. 复制本文件为 .env 后生效（开发时 pnpm dev 自动读取）
# 4. 在 Supabase 的 SQL Editor 中执行下面的建表语句
# 5. 关闭自助注册（必须！否则有人绕过界面直接调 API 注册）：
#    Authentication -> Sign In / Providers -> Email -> 关闭 "Allow new users to sign up"
# 6. 日常账号管理（管理员操作）：
#    - 创建账号：Authentication -> Users -> Add User（勾选 Auto Confirm User）
#    - 停用账号（到期不续费）：Users 列表 -> 对应用户 -> Ban User
#    - 重置密码：Users 列表 -> 对应用户 -> Reset Password / 手动修改
#
# ---- 建表 SQL（复制到 Supabase SQL Editor 执行）----
# create table if not exists scores (
#   id bigint generated by default as identity primary key,
#   user_id uuid references auth.users not null,
#   name text not null,
#   data jsonb not null,
#   updated_at timestamptz default now()
# );
# alter table scores enable row level security;
# create policy "users manage own scores" on scores
#   for all using (auth.uid() = user_id) with check (auth.uid() = user_id);
# --------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
